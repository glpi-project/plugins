{
   "name": "glpi-plugin-directory/api",
   "description": "The Server-code for the API of glpi-plugin-directory",
   "authors": [
      {
         "name": "Nelson Zamith",
         "email": "nzamith@teclib.com"
      }
   ],
   "require": {
      "php": "^7.4",
      "ext-PDO": "*",
      "ext-curl": "*",
      "ext-dom": "*",
      "ext-json": "*",
      "ext-libxml": "*",
      "ext-mbstring": "*",
      "ext-pdo_mysql": "*",
      "ext-simplexml": "*",
      "google/recaptcha": "^1.1",
      "illuminate/database": "5.1.*",
      "illuminate/events": "5.1.*",
      "laminas/laminas-uri": "^2.8",
      "league/oauth2-client": "^1.0",
      "league/oauth2-github": "^0.2.0",
      "league/oauth2-server": "^4.1",
      "slim/slim": "~2.0",
      "suin/php-rss-writer": ">=1.0",
      "swiftmailer/swiftmailer": "^5.4",
      "tgalopin/html-sanitizer": "^1.4",
      "twig/twig": "~1.0"
   },
   "autoload": {
      "psr-4": {
         "API\\Core\\": "src/core",
         "API\\Model\\": "src/models",
         "API\\OAuthServer\\": "src/oauthserver",
         "API\\Exception\\": "src/exceptions"
      }
   },
   "require-dev": {
      "guzzlehttp/guzzle": "^6.0",
      "mockery/mockery": "^1.6",
      "phpunit/phpunit": "^9.5",
      "symfony/process": "^5.0"
   },
   "autoload-dev": {
      "psr-4": {
         "Tests\\": "tests/"
      }
   },
   "extra": {
      "upgrade-notes": [
         "slim/slim is pinned to ~2.0 — index.php has a get_magic_quotes_gpc() polyfill that must be removed when upgrading to Slim 3+.",
         "illuminate/database is pinned to 5.1.* — vendor/nesbot/carbon Carbon.php has a manual PHP 8.2 compat patch (getLastErrors() returning false) that must be removed when upgrading Eloquent/Carbon."
      ]
   },
   "config": {
      "optimize-autoloader": true,
      "sort-packages": true,
      "platform": {
         "php": "7.4.0"
      },
      "allow-plugins": {
         "kylekatarnls/update-helper": true
      }
   }
}
